      "blocking": true,
      "default_status": "UNKNOWN"
    },
    {
      "id": "visionpro-handtracking",
      "kind": "declared",
      "scope": "client",
      "description": "Local Network and Hand Tracking permissions are granted and the streamed red tracked-joint markers are visible and responsive.",
      "required": true,
      "blocking": true,
      "default_status": "UNKNOWN"
    },
    {
      "id": "retargeting-calibration",
      "kind": "declared",
      "scope": "operator",
