+        // Request permission as part of Connect; no separate setup controls.
+        private func requestLocalNetwork() async throws {
+            try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Void, Error>) in
+                let browser = NWBrowser(for: .bonjour(type: "_cloudxr._tcp", domain: "local."), using: .tcp)
+                var finished = false
+                var timeout: DispatchWorkItem?
+                func finish(_ result: Result<Void, Error>) {
+                    guard !finished else { return }
+                    finished = true
+                    timeout?.cancel()
+                    browser.stateUpdateHandler = nil
+                    browser.cancel()
+                    continuation.resume(with: result)
+                }
+                browser.stateUpdateHandler = { state in
+                    switch state {
+                    case .ready: finish(.success(()))
+                    case .failed(let error), .waiting(let error):
+                        finish(.failure(NSError(domain: "LocalNetwork", code: Int(error.errorCode), userInfo: [
+                            NSLocalizedDescriptionKey: "Local network access is unavailable. Allow Local Network in Settings → Privacy & Security, then reconnect. \(error.localizedDescription)"
+                        ])))
+                    default: break
+                    }
+                }
+                let deadline = DispatchWorkItem {
+                    finish(.failure(NSError(domain: "LocalNetwork", code: 1, userInfo: [NSLocalizedDescriptionKey: "Local network permission timed out. Allow access when prompted, then reconnect."])))
+                }
+                timeout = deadline
+                DispatchQueue.main.asyncAfter(deadline: .now() + 30, execute: deadline)
+                browser.start(queue: .main)
+            }
+        }
+
+        @MainActor
+        private func reportFailure(_ error: Error) async {
+            guard !reportedFailure else { return }
+            reportedFailure = true
+            if appModel.immersiveSpaceIsOpen { await appModel.dismissImmersiveSpace() }
+            appModel.connectionError = Self.describe(error)
+        }
 
