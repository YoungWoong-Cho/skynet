+                                userInfo: [
+                                    NSLocalizedDescriptionKey:
+                                        "Local network permission timed out. Allow access when prompted, then reconnect."
+                                ])))
+                }
+                timeout = deadline
+                DispatchQueue.main.asyncAfter(deadline: .now() + 30, execute: deadline)
+                browser.start(queue: .main)
+            }
